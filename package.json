{
  "name": "dsh-openai-codex-auth",
  "version": "0.5.7",
  "description": "DeepSeek Harness plugin for multi-account OpenAI Codex OAuth, usage, web search, and image generation",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Eve-146T/DSH-CODEX-SUBSCRIPTION-POOL.git"
  },
  "homepage": "https://github.com/Eve-146T/DSH-CODEX-SUBSCRIPTION-POOL#readme",
  "bugs": "https://github.com/Eve-146T/DSH-CODEX-SUBSCRIPTION-POOL/issues",
  "keywords": ["deepseek-harness", "deepseek-harness-plugin", "dsh-plugin", "openai", "codex", "oauth", "chatgpt", "image-generation", "web-search"],
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": { "types": "./lib/index.d.ts", "default": "./lib/index.js" },
    "./image-tool": { "types": "./lib/image-tool.d.ts", "default": "./lib/image-tool.js" },
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": ["lib", "client.js", "cordis.patch.yml", "README.md", "LICENSE", "NOTICE"],
  "scripts": {
    "build": "tsc",
    "test": "vitest run"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-tool"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-credentials": "^0.1.0-rc.6"
  },
  "dependencies": {
    "@deepseek-ai/dsh-atomic-write": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-home-paths": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-credentials": "^0.1.0-rc.6",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-attachment": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-credentials": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6",
    "@types/node": "^22.20.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
