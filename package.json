{
  "name": "dsh-openai-codex-auth",
  "version": "0.5.11",
  "description": "DeepSeek Harness plugin for OpenAI Codex OAuth, pooled accounts, model awareness, official docs, web search, and image generation",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Eve-146T/DSH-CODEX-SUBSCRIPTION-POOL.git"
  },
  "homepage": "https://github.com/Eve-146T/DSH-CODEX-SUBSCRIPTION-POOL#readme",
  "bugs": "https://github.com/Eve-146T/DSH-CODEX-SUBSCRIPTION-POOL/issues",
  "keywords": [
    "deepseek-harness",
    "deepseek-harness-plugin",
    "dsh-plugin",
    "openai",
    "codex",
    "oauth",
    "chatgpt",
    "image-generation",
    "web-search"
  ],
  "type": "module",
  "engines": {
    "node": ">=24.9.0",
    "dsh": "0.2.2-rc.3"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./image-tool": {
      "types": "./lib/image-tool.d.ts",
      "default": "./lib/image-tool.js"
    },
    "./model-awareness": {
      "types": "./lib/model-awareness.d.ts",
      "default": "./lib/model-awareness.js"
    },
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "skills",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-tool"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-credentials": "0.2.2-rc.3",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-rc.3"
  },
  "dependencies": {
    "@deepseek-ai/dsh-atomic-write": "0.2.2-rc.3",
    "@deepseek-ai/dsh-credentials": "0.2.2-rc.3",
    "@deepseek-ai/dsh-home-paths": "0.2.2-rc.3",
    "@deepseek-ai/schemastery": "3.19.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-api-gateway": "0.2.2-rc.3",
    "@deepseek-ai/dsh-attachment": "0.2.2-rc.3",
    "@deepseek-ai/dsh-brand": "0.2.2-rc.3",
    "@deepseek-ai/dsh-credentials": "0.2.2-rc.3",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.3",
    "@deepseek-ai/dsh-llm-pi-ai": "0.2.2-rc.3",
    "@deepseek-ai/dsh-skill": "0.2.2-rc.3",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-rc.3",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.3",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-rc.3",
    "@deepseek-ai/dsh-typert-registry": "0.2.2-rc.3",
    "@deepseek-ai/dsh-web": "0.2.2-rc.3",
    "@types/node": "^22.20.0",
    "@types/react": "18.3.1",
    "@types/react-dom": "18.3.0",
    "@types/ws": "^8.5.14",
    "jsdom": "26.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "scripts": {
    "build": "tsc",
    "test": "pnpm run build && tsc -p tsconfig.tests.json && vitest run",
    "typecheck": "tsc --noEmit"
  }
}
